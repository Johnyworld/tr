# 로컬 설정. 이 파일을 .env로 복사해 쓴다 (MCP 서버가 시작할 때 읽는다. API 키는 필요 없다)

# RAG(lore·기억 검색). off로 끄면 임베딩 모델을 받지 않는다
# RAG=on

# 시나리오 팩 (content/scenarios/<id>/)
# SCENARIO=post_apoc

# 세이브 폴더와 콘텐츠 폴더 (저장소 루트 기준). CONTENT_DIR을 주면 SCENARIO 대신 그 폴더를 쓴다
# SAVES_DIR=saves
# CONTENT_DIR=content/scenarios/post_apoc

# 상태 화면 (캐릭터 시트). off로 끄고, 포트는 쓰이고 있으면 다음 번호로
# TRPG_STATUS=on
# TRPG_STATUS_PORT=8790

# 치트 (개발 모드, 테스트용). 1이면 Claude 세션에서 ~명령(예: ~kill me, ~give shotgun)을 쓸 수 있다
# 바꾼 뒤 Claude 세션을 새로 연다. 치트를 쓴 세이브에는 표시가 남는다
# TRPG_DEBUG=1
