# Claude API 키 (Console에서 발급). 이 파일을 .env로 복사해 채운다
ANTHROPIC_API_KEY=

# GM 서술 모델 (기본값: claude-opus-5-5)
# GM_MODEL=claude-opus-5-5

# 장면 요약 모델 (기본값: claude-haiku-5-5)
# SUMMARY_MODEL=claude-haiku-5-5

# 서버 포트 (기본값: 8787)
# SERVER_PORT=8787

# RAG(lore 검색). off로 끄면 임베딩 모델을 받지 않는다
# RAG=on

# 시나리오 팩 (content/scenarios/<id>/)
# SCENARIO=post_apoc

# 세이브 폴더와 콘텐츠 폴더 (저장소 루트 기준). CONTENT_DIR을 주면 SCENARIO 대신 그 폴더를 쓴다
# SAVES_DIR=saves
# CONTENT_DIR=content/scenarios/post_apoc

# 치트 (개발 모드, 테스트용). 1이면 웹 앱·Claude 세션에서 ~명령(예: ~kill me, ~give shotgun)을 쓸 수 있다
# 바꾼 뒤 웹 서버를 재시작하고, Claude 세션은 새로 연다. 치트를 쓴 세이브에는 표시가 남는다
# TRPG_DEBUG=1
