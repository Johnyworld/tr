{
  "name": "trpg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trpg/server --filter @trpg/ui dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "content:check": "pnpm --filter @trpg/core content:check",
    "mcp": "pnpm --silent --filter @trpg/mcp start",
    "rag:eval": "pnpm --silent --filter @trpg/core rag:eval"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
